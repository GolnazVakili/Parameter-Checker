<Window x:Class="ParameterQc.UI.ParameterPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter QC"
        Width="980"
        Height="760"
        MinWidth="820"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI"
        FontSize="13"
        SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Choose parameters" />
            <TextBlock x:Name="ScopeText" Margin="0,6,0,0" Foreground="#555555" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,14,0,8">
            <Button Content="Save as default" DockPanel.Dock="Right" Margin="8,0,0,0" Click="SaveDefault_Click" />
            <Button Content="Clear" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Clear_Click" />
            <Button Content="Select shown" DockPanel.Dock="Right" Click="SelectShown_Click" />
            <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" TextChanged="SearchBox_TextChanged" />
        </DockPanel>

        <TabControl x:Name="ParameterTabs" Grid.Row="2" Background="White" BorderBrush="#D0D7E2" BorderThickness="1">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Background="#F4F7FB" />
                        <ContentPresenter ContentSource="SelectedContent" Margin="0,4,0,0" />
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="96" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="OkButton" Content="OK" Width="96" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
            <TextBlock x:Name="SelectionCountText" VerticalAlignment="Center" Foreground="#555555" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
