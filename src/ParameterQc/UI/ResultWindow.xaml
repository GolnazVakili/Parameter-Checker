<Window x:Class="ParameterQc.UI.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter QC"
        Width="1180"
        Height="780"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI"
        FontSize="13"
        SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="QC – Populated Parameter" />
            <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Foreground="#555555" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="4" Padding="8">
            <ContentControl x:Name="ChartHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>

        <WrapPanel x:Name="LegendPanel" Grid.Row="2" Margin="0,12,0,0" />

        <TextBlock x:Name="RulesText" Grid.Row="3" Margin="0,10,0,0" Foreground="#666666" TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Export Excel" Width="120" Margin="0,0,8,0" Click="Export_Click" />
            <Button Content="Close" Width="96" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
